{
  "$defs": {
    "AudioPcmOptions": {
      "additionalProperties": false,
      "description": "Options accepted by `extract_audio_pcm`.",
      "properties": {
        "audioStreamIndex": {
          "description": "Explicit ffprobe stream index. Omitted means the lowest non-attached\naudio stream.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "channels": {
          "description": "Output channel count (1 or 2); omitted keeps the source layout.",
          "format": "uint16",
          "maximum": 2,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "endMs": {
          "description": "Material end of the requested window; defaults to the track end.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sampleRate": {
          "description": "Output sample rate; omitted keeps the source rate.",
          "format": "uint32",
          "maximum": 192000,
          "minimum": 8000,
          "type": [
            "integer",
            "null"
          ]
        },
        "startMs": {
          "description": "Material start of the requested half-open window; defaults to 0.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CancelMessageType": {
      "enum": [
        "cancel"
      ],
      "type": "string"
    },
    "CancelRequest": {
      "additionalProperties": false,
      "properties": {
        "engineProtocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "messageType": {
          "$ref": "#/$defs/CancelMessageType"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "engineProtocolVersion",
        "messageType",
        "requestId"
      ],
      "type": "object"
    },
    "EmptyOptions": {
      "additionalProperties": false,
      "description": "Options accepted by `probe` and `extract_preview`: exactly `{}`.",
      "type": "object"
    },
    "ExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "runId": {
          "$ref": "#/$defs/Identifier"
        },
        "scope": {
          "$ref": "#/$defs/ExecutionScope"
        }
      },
      "required": [
        "runId",
        "generation",
        "attempt",
        "scope"
      ],
      "type": "object"
    },
    "ExecutionScope": {
      "description": "Request origin scope. `cacheScope` never enters the engine protocol.",
      "enum": [
        "asset",
        "query",
        "evaluation"
      ],
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "InputDescriptor": {
      "additionalProperties": false,
      "description": "One staged logical input.",
      "properties": {
        "byteSize": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contentHash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "ref": {
          "$ref": "#/$defs/InputRef"
        },
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "role",
        "ref",
        "contentHash",
        "byteSize"
      ],
      "type": "object"
    },
    "InputRef": {
      "const": "input/source.media",
      "type": "string"
    },
    "InputRole": {
      "const": "source_media",
      "type": "string"
    },
    "Operation": {
      "description": "Operations registered by Protocol 0.1.",
      "enum": [
        "probe",
        "extract_preview",
        "extract_audio_pcm"
      ],
      "type": "string"
    },
    "OperationOptions": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmptyOptions"
        },
        {
          "$ref": "#/$defs/AudioPcmOptions"
        }
      ],
      "description": "Operation-specific options. The wire shape must match the request\noperation; [`OperationOptions::Empty`] is valid for every operation and is\nthe canonical \"no options\" value.\n\nUnknown keys, duplicate keys and non-object shapes are rejected while\nparsing, so no free-form options map can enter the protocol."
    },
    "OutputContractVersion": {
      "pattern": "^[a-z0-9-]+/[0-9]+$",
      "type": "string"
    },
    "ProtocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StartMessageType": {
      "enum": [
        "start"
      ],
      "type": "string"
    },
    "StartRequest": {
      "additionalProperties": false,
      "description": "Host-facing start request. `executionContext` is required; `version` and\n`doctor` never use this DTO.",
      "properties": {
        "deadlineMs": {
          "format": "uint64",
          "maximum": 600000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "derivationKey": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "engineProtocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "executionContext": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "inputFingerprint": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputDescriptor"
          },
          "type": "array"
        },
        "messageType": {
          "$ref": "#/$defs/StartMessageType"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "operationConfigHash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "options": {
          "$ref": "#/$defs/OperationOptions"
        },
        "outputContractVersion": {
          "$ref": "#/$defs/OutputContractVersion"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceVersionId": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "engineProtocolVersion",
        "messageType",
        "requestId",
        "operation",
        "sourceVersionId",
        "inputs",
        "inputFingerprint",
        "operationConfigHash",
        "outputContractVersion",
        "derivationKey",
        "executionContext",
        "options"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/StartRequest"
    },
    {
      "$ref": "#/$defs/CancelRequest"
    }
  ],
  "title": "ControlMessageSchema"
}
