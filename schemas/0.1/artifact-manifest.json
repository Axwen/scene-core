{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Identifier"
        },
        "audioPcm": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioPcmInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "byteSize": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contentHash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "mediaType": {
          "$ref": "#/$defs/MediaType"
        },
        "pixelHeight": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pixelWidth": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "presentationTimeMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "relativeRef": {
          "$ref": "#/$defs/RelativeRef"
        },
        "requestedTimeMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "role",
        "mediaType",
        "relativeRef",
        "byteSize",
        "contentHash",
        "requestedTimeMs"
      ],
      "type": "object"
    },
    "ArtifactKind": {
      "description": "Artifact kinds frozen by Protocol 0.1.",
      "enum": [
        "previewFrame",
        "audioPcm"
      ],
      "type": "string"
    },
    "ArtifactRole": {
      "description": "Fixed artifact roles: diagnostic preview frames and the extracted audio\ntrack.",
      "enum": [
        "opening",
        "midpoint",
        "audio"
      ],
      "type": "string"
    },
    "AudioPcmInfo": {
      "additionalProperties": false,
      "description": "Audio-specific mapping fields. Present exactly on `audioPcm` artifacts.\n`presentation_time_ms` carries the material time of the first output\nsample; these fields complete the mapping\n`materialTime = presentationTimeMs + sampleIndex / sampleRate`.",
      "properties": {
        "channels": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sampleCount": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sampleRate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sampleRate",
        "channels",
        "sampleCount"
      ],
      "type": "object"
    },
    "CacheCompatibilityId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "CommitHash": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "EngineIdentity": {
      "additionalProperties": false,
      "description": "Shared identity of the engine build. Reused by events, Manifests, `version`\nand `doctor`; no consumer may define an approximate variant.",
      "properties": {
        "engineCacheCompatibilityId": {
          "$ref": "#/$defs/CacheCompatibilityId"
        },
        "engineCommit": {
          "$ref": "#/$defs/CommitHash"
        },
        "engineVersion": {
          "type": "string"
        },
        "implementedOperations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "type": "array"
        },
        "supportedProtocolVersions": {
          "items": {
            "$ref": "#/$defs/ProtocolVersion"
          },
          "type": "array"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "engineVersion",
        "engineCommit",
        "target",
        "engineCacheCompatibilityId",
        "supportedProtocolVersions",
        "implementedOperations"
      ],
      "type": "object"
    },
    "Identifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "MediaType": {
      "maxLength": 128,
      "pattern": "^[a-z0-9.+_-]+/[a-z0-9.+_-]+$",
      "type": "string"
    },
    "Operation": {
      "description": "Operations registered by Protocol 0.1.",
      "enum": [
        "probe",
        "extract_preview",
        "extract_audio_pcm"
      ],
      "type": "string"
    },
    "OutputContractVersion": {
      "pattern": "^[a-z0-9-]+/[0-9]+$",
      "type": "string"
    },
    "ProtocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "RelativeRef": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!.*(^|/)\\.\\.?(/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manifest of one immutable Artifact set. Contains no timestamp or resource\nstatistics; `probe` never produces one.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "type": "array"
    },
    "derivationKey": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "engine": {
      "$ref": "#/$defs/EngineIdentity"
    },
    "inputFingerprint": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "manifestVersion": {
      "$ref": "#/$defs/ProtocolVersion"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "operationConfigHash": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "outputContractVersion": {
      "$ref": "#/$defs/OutputContractVersion"
    },
    "requestId": {
      "$ref": "#/$defs/Identifier"
    },
    "sourceVersionId": {
      "$ref": "#/$defs/Identifier"
    },
    "toolchainFingerprint": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "manifestVersion",
    "requestId",
    "sourceVersionId",
    "inputFingerprint",
    "derivationKey",
    "operation",
    "operationConfigHash",
    "outputContractVersion",
    "engine",
    "toolchainFingerprint",
    "artifacts"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
