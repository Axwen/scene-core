{
  "$defs": {
    "CacheCompatibilityId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "CommitHash": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "DescriptorVersion": {
      "description": "Frozen descriptor schema revision. Protocol 0.1 registers only `\"1\"` for\nboth `inputSetVersion` and `derivationDescriptorVersion`.",
      "enum": [
        "1"
      ],
      "type": "string"
    },
    "DoctorCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/DoctorCheckCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/DoctorCheckName"
        },
        "nextStep": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/DoctorStatus"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "type": "object"
    },
    "DoctorCheckCode": {
      "description": "Stable doctor failure codes.",
      "enum": [
        "PACKAGE_MANIFEST_UNREADABLE",
        "PACKAGE_MANIFEST_INVALID",
        "TRUST_ANCHOR_MISSING",
        "MANIFEST_DIGEST_MISMATCH",
        "BUNDLE_FILE_INVALID",
        "TOOLCHAIN_DESCRIPTOR_INVALID",
        "ENGINE_EXECUTABLE_INVALID",
        "ENGINE_VERSION_MISMATCH",
        "TOOL_EXECUTABLE_INVALID",
        "TOOL_VERSION_MISMATCH",
        "CAPABILITIES_INVALID",
        "TEMP_DIR_UNAVAILABLE"
      ],
      "type": "string"
    },
    "DoctorCheckName": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "DoctorStatus": {
      "enum": [
        "ok",
        "failed"
      ],
      "type": "string"
    },
    "EngineIdentity": {
      "additionalProperties": false,
      "description": "Shared identity of the engine build. Reused by events, Manifests, `version`\nand `doctor`; no consumer may define an approximate variant.",
      "properties": {
        "engineCacheCompatibilityId": {
          "$ref": "#/$defs/CacheCompatibilityId"
        },
        "engineCommit": {
          "$ref": "#/$defs/CommitHash"
        },
        "engineVersion": {
          "type": "string"
        },
        "implementedOperations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "type": "array"
        },
        "supportedProtocolVersions": {
          "items": {
            "$ref": "#/$defs/ProtocolVersion"
          },
          "type": "array"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "engineVersion",
        "engineCommit",
        "target",
        "engineCacheCompatibilityId",
        "supportedProtocolVersions",
        "implementedOperations"
      ],
      "type": "object"
    },
    "Operation": {
      "description": "Operations registered by Protocol 0.1.",
      "enum": [
        "probe",
        "extract_preview",
        "extract_audio_pcm"
      ],
      "type": "string"
    },
    "ProtocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ToolchainIdentity": {
      "additionalProperties": false,
      "description": "Shared fixed-toolchain identity. The fingerprint covers target, FFmpeg and\nFFprobe versions, build source, configure flags, capabilities and the\ndynamic library closure.",
      "properties": {
        "capabilitySetFingerprint": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "ffmpegVersion": {
          "type": "string"
        },
        "ffprobeVersion": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "toolchainFingerprint": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "toolchainFingerprint",
        "target",
        "ffmpegVersion",
        "ffprobeVersion",
        "capabilitySetFingerprint"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`doctor --json` output with ordered, stable checks.",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/DoctorCheck"
      },
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/EngineIdentity"
    },
    "schemaVersion": {
      "$ref": "#/$defs/DescriptorVersion"
    },
    "status": {
      "$ref": "#/$defs/DoctorStatus"
    },
    "toolchain": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolchainIdentity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "engine",
    "checks"
  ],
  "title": "DoctorOutput",
  "type": "object"
}
