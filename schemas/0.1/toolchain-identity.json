{
  "$defs": {
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Shared fixed-toolchain identity. The fingerprint covers target, FFmpeg and\nFFprobe versions, build source, configure flags, capabilities and the\ndynamic library closure.",
  "properties": {
    "capabilitySetFingerprint": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "ffmpegVersion": {
      "type": "string"
    },
    "ffprobeVersion": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "toolchainFingerprint": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "toolchainFingerprint",
    "target",
    "ffmpegVersion",
    "ffprobeVersion",
    "capabilitySetFingerprint"
  ],
  "title": "ToolchainIdentity",
  "type": "object"
}
