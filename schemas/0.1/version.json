{
  "$defs": {
    "CacheCompatibilityId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "CommitHash": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "DescriptorVersion": {
      "description": "Frozen descriptor schema revision. Protocol 0.1 registers only `\"1\"` for\nboth `inputSetVersion` and `derivationDescriptorVersion`.",
      "enum": [
        "1"
      ],
      "type": "string"
    },
    "Operation": {
      "description": "Operations frozen by Protocol 0.1.",
      "enum": [
        "probe",
        "extract_preview"
      ],
      "type": "string"
    },
    "ProtocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`version --json` output. Mirrors the shared `EngineIdentity` plus the\ntoolchain fingerprint and a CLI schema version.",
  "properties": {
    "engineCacheCompatibilityId": {
      "$ref": "#/$defs/CacheCompatibilityId"
    },
    "engineCommit": {
      "$ref": "#/$defs/CommitHash"
    },
    "engineVersion": {
      "type": "string"
    },
    "implementedOperations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "type": "array"
    },
    "schemaVersion": {
      "$ref": "#/$defs/DescriptorVersion"
    },
    "supportedProtocolVersions": {
      "items": {
        "$ref": "#/$defs/ProtocolVersion"
      },
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "toolchainFingerprint": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "engineCommit",
    "target",
    "engineCacheCompatibilityId",
    "toolchainFingerprint",
    "supportedProtocolVersions",
    "implementedOperations"
  ],
  "title": "VersionOutput",
  "type": "object"
}
